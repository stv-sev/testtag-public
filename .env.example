# Vorlage für die lokale Konfiguration – nur Platzhalter, wird versioniert.
# Einmalig nach `.env` im Projektstamm kopieren und dort die echten Werte eintragen.
# `.env` ist durch .gitignore ausgeschlossen und darf nie weitergegeben werden.
# Werte mit Leerzeichen in "…" setzen. Keine Variablenersetzung, keine mehrzeiligen Werte.
# Gesetzte Prozessvariablen haben Vorrang vor `.env`.
SUPABASE_URL=https://<projekt-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<platzhalter>
SUPABASE_SECRET_KEY=sb_secret_<platzhalter-nur-lokal>
TESTTAG_WORKBOOK_AK5_AK9PLUS="<absoluter lokaler Pfad>\261009-Test-AK5-AK9plus.xlsx"
TESTTAG_WORKBOOK_AK9_AK12="<absoluter lokaler Pfad>\261009-Test-AK9-AK12.xlsx"
TESTTAG_POLL_SECONDS=5
